# Configure secrets only in a private environment;this file has no credentials.
SAFELEDGER_DB=./safeledger.sqlite3
SAFELEDGER_BUILD_COMMIT=development

# M2 financial mutations require a private random64-hex signing key.
# Generate via scripts/bootstrap_demo.py; keep it across restarts, never commit it.
SAFELEDGER_SIGNING_KEY=

# M3 zero-money setup. Check AI Studio shows Free tier with billing disabled.
# This acknowledgement is NOT automatic billing verification. See docs/FREE_AI_SETUP.md.
SAFELEDGER_LLM_PROFILE=gemini_free
SAFELEDGER_LLM_FREE_TIER_CONFIRMED=0
SAFELEDGER_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
SAFELEDGER_LLM_MODEL=gemini-3.8-flash
SAFELEDGER_LLM_API_KEY=
# Exact HTTPS host allowlist; never supplied by an HTTP request.
SAFELEDGER_LLM_ALLOWED_HOSTS=generativelanguage.googleapis.com
