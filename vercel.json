{
  "buildCommand": "npm run build --prefix web",
  "outputDirectory": "web/dist",
  "installCommand": "npm install --prefix web",
  "framework": null,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://safeledger-ai.onrender.com/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    }
  ]
}
