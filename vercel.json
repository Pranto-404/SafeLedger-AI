{
  "buildCommand": "npm ci --prefix web && npm run build --prefix web",
  "installCommand": "python -m pip install -r requirements.txt",
  "framework": "fastapi",
  "rewrites": [
    {
      "source": "/",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
        }
      ]
    }
  ],
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "fluid": true,
  "functions": {
    "api/vercel.py": {
      "maxDuration": 300,
      "excludeFiles": "{.private/**,api/tests/**,data/**,docs/**,evidence/**,scripts/**,submission/**,web/**,node_modules/**,public/**}"
    }
  }
}
